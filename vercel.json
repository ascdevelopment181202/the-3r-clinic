{
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/About.dc.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/Ayurveda.dc.html",
      "destination": "/ayurveda",
      "permanent": true
    },
    {
      "source": "/Diet.dc.html",
      "destination": "/diet",
      "permanent": true
    },
    {
      "source": "/Reviews.dc.html",
      "destination": "/reviews",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?!.*-git-).*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.the3rclinic.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?!.*-git-).*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.the3rclinic.com/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/About.dc.html"
    },
    {
      "source": "/ayurveda",
      "destination": "/Ayurveda.dc.html"
    },
    {
      "source": "/diet",
      "destination": "/Diet.dc.html"
    },
    {
      "source": "/reviews",
      "destination": "/Reviews.dc.html"
    }
  ]
}